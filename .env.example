# ═══════════════════════════════════════════════════════════════
# CREARD - Variables de Entorno
# Copia este archivo a .env.local y completa los valores
# ═══════════════════════════════════════════════════════════════

# ── Base de datos (Prisma/SQLite legacy - no activo) ──
DATABASE_URL="file:./dev.db"

# ── Firebase ──
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Firebase Admin (Service Account JSON como string base64)
FIREBASE_SERVICE_ACCOUNT_KEY=""

# ── Autenticación ──
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── SMTP (Correo de confirmación de reclamos - REQUISITO 2) ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@creard.com"

# ── WhatsApp Business API ──
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# ── Culqi (Pagos con tarjeta) ──
NEXT_PUBLIC_CULQI_PUBLIC_KEY=""
CULQI_INTEGRATION_KEY=""
CULQI_WEBHOOK_SECRET=""

# ── Notificaciones por Email ──
NOTIFICATION_EMAIL=""
NOTIFICATION_EMAIL_ENABLED="false"

# ═══════════════════════════════════════════════════════════════
# REQUISITO 5 (AUDITORÍA): HTTPS local con mkcert
# ═══════════════════════════════════════════════════════════════
# Para desarrollo local con HTTPS:
# 1. Instalar mkcert: brew install mkcert (macOS) o apt install mkcert (Linux)
# 2. mkcert -install (instalar CA local)
# 3. mkcert localhost 127.0.0.1 (generar certificados)
# 4. Mover cert.pem y key.pem a la raíz del proyecto
# 5. Agregar a next.config.ts:
#    serverOptions: { https: { key: fs.readFileSync('./key.pem'), cert: fs.readFileSync('./cert.pem') } }
#
# En producción (Vercel), HTTPS es automático - no requiere configuración.
# ═══════════════════════════════════════════════════════════════

